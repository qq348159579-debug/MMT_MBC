PORT=3000

# SQL Server connection
# 支持两种写法：
# 1) SQL_SERVER=localhost\\SQLEXPRESS
# 2) SQL_HOST=localhost  + SQL_INSTANCE=SQLEXPRESS
SQL_SERVER=localhost\\SQLEXPRESS
SQL_DATABASE=TMS
SQL_USER=tms_app
SQL_PASSWORD=PLEASE_SET_ME

# SSL / certificate (推荐保持 true，避免证书链报错)
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=true

